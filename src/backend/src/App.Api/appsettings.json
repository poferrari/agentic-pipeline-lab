{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExternalApis": {
    "FrankfurterBaseUrl": "https://api.frankfurter.app/",
    "FrankfurterLeakyBucket": {
      "Enabled": true,
      "Capacity": 20,
      "LeakRatePerSecond": 5,
      "MaxQueueWaitSeconds": 5
    }
  },
  "Auth": {
    "AllowDemoHeader": true
  },
  "Supabase": {
    "Url": "https://jrhpbdftohjeymzwkbee.supabase.co"
  },
  "Ai": {
    "ModelId": "gemini-2.5-flash",
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/"
  },
  "Messaging": {
    "Retry": {
      "Limit": 10,
      "InitialIntervalSeconds": 1,
      "MaxIntervalSeconds": 30,
      "IntervalDeltaSeconds": 2
    },
    "DeadLetter": {
      "QueueName": "marketpulse.currency-alerts_error"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://agentic-pipeline-lab.onrender.com",
      "https://agentic-pipeline-lab-web.onrender.com"
    ]
  },
  "OriginShielding": {
    "Enabled": false,
    "Secret": ""
  }
}
