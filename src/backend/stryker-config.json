{
  "stryker-config": {
    "solution": "MarketPulse.sln",
    "mutate": [
      "**/src/App.Domain/**/*.cs",
      "**/src/App.Application/**/*.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 45
    },
    "reporters": [
      "progress",
      "json",
      "html"
    ],
    "concurrency": 4,
    "test-case-filter": "FullyQualifiedName~App.UnitTests"
  }
}
