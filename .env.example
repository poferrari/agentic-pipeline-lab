# =============================================================================
# VARIÁVEIS DE AMBIENTE DE EXEMPLO (NUNCA COMMITE O ARQUIVO .env REAL)
# =============================================================================

# --- Infraestrutura Local (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=marketpulse_db
POSTGRES_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Backend (.NET 9 C# Minimal API) ---
ConnectionStrings__Database="Host=localhost;Port=5432;Database=marketpulse_db;Username=postgres;Password=postgres_dev_password"
ConnectionStrings__RabbitMq="amqp://guest:guest@localhost:5672"
Supabase__Url="https://your-project-ref.supabase.co"
Auth__AllowDemoHeader="true"
Cors__AllowedOrigins__0="http://localhost:3000"

# --- Observabilidade & Telemetria (OpenTelemetry / Grafana Cloud / Aspire) ---
# Opção 1: Aspire Dashboard local (padrão no docker-compose: http://localhost:18888)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="MarketPulse.Api"

# Opção 2: Grafana Cloud (https://bigveranda1683.grafana.net)
# Obtenha em: Connections -> Add new connection -> OpenTelemetry -> Configure -> Generate Token
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <BASE64_TOKEN_DO_GRAFANA_CLOUD>"

# --- Frontend (Next.js / React + TypeScript) ---
NEXT_PUBLIC_API_URL="http://localhost:8080"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key-here"
