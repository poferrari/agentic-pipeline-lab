# =============================================================================
# VARIÁVEIS DE AMBIENTE DE EXEMPLO (NUNCA COMMITE O ARQUIVO .env REAL)
# =============================================================================

# --- Infraestrutura Local (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=app_dev_db
POSTGRES_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Backend (.NET C# Minimal API) ---
ConnectionStrings__Database="Host=localhost;Port=5432;Database=app_dev_db;Username=postgres;Password=postgres_dev_password"
ConnectionStrings__RabbitMq="amqp://guest:guest@localhost:5672"
Supabase__Url="https://your-project-ref.supabase.co"
Cors__AllowedOrigins__0="http://localhost:3000"

# --- Frontend (Next.js / React + TypeScript) ---
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key-here"

